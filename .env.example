# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:4321,http://127.0.0.1:4321,https://piter-jaluzi.ru,https://www.piter-jaluzi.ru
API_URL=http://localhost:3001
PUBLIC_API_BASE_URL=http://localhost:3001

# Storage
# Local: leave empty to use back/data and back/src/uploads
# Render: set STORAGE_DIR to your mounted disk path, e.g. /var/data/jaluzi
STORAGE_DIR=
# Optional explicit overrides:
# DB_PATH=/var/data/jaluzi/data/db.json
# AUTHORIZED_CHATS_FILE=/var/data/jaluzi/data/authorizedChats.json
# UPLOADS_DIR=/var/data/jaluzi/uploads

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_PASSWORD=12345

# Email - ИСХОДЯЩАЯ (отправка уведомлений)
EMAIL_HOST=mail.hosting.reg.ru
EMAIL_PORT=465
EMAIL_USER=info@piter-jaluzi.ru
EMAIL_PASS=your-app-password-here

# Email - ВХОДЯЩАЯ (приём писем для пересылки)
INCOMING_EMAIL_HOST=mail.hosting.reg.ru
INCOMING_EMAIL_PORT=993
INCOMING_EMAIL_USER=info@piter-jaluzi.ru
INCOMING_EMAIL_PASS=your-app-password-here

# Email - ЛИЧНАЯ (куда пересылать)
FORWARD_EMAIL=ABCD@yandex.ru
